{
  "name": "shardy-template",
  "version": "1.3.0",
  "description": "Template service for Shardy",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "author": "Mopsicus <mail@mopsicus.ru>",
  "homepage": "https://github.com/mopsicus/shardy-template",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build-ts": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "format:check": "prettier --config .prettierrc --check 'src/**/*.ts'",
    "build": "npm run clean && npm run build-ts",
    "debug": "npm run build && npm run watch-debug",
    "lint": "eslint src",
    "serve-debug": "nodemon --inspect --watch src --ext ts --watch .env.dev --delay 500ms dist/app.js",
    "serve": "node dist/app.js",
    "start": "npm run serve",
    "watch-debug": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"yellow.bold,cyan.bold,green.bold\" \"npm run watch-ts\" \"npm run serve-debug\"",
    "watch-node": "nodemon --watch src --ext ts --watch .env.dev --delay 500ms dist/app.js",
    "watch-ts": "tsc -w",
    "watch": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"yellow.bold,cyan.bold,green.bold\" \"npm run watch-ts\" \"npm run watch-node\""
  },
  "keywords": [
    "shardy",
    "microservice",
    "framework",
    "rpc",
    "web",
    "template",
    "netcode",
    "networking",
    "games",
    "engine",
    "multiplayer",
    "websocket",
    "realtime",
    "server",
    "socket",
    "typescript",
    "nodejs"
  ],
  "bugs": {
    "url": "https://github.com/mopsicus/shardy-template/issues"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "shardy": "^1.4.0",
    "winston": "^3.19.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.12.1"
}
